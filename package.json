{
  "name": "fullstack-project-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "bun run build && wrangler deploy",
    "dev": "react-router dev",
    "postinstall": "bun run cf-typegen",
    "preview": "bun run build && vite preview",
    "typecheck": "bun run cf-typegen && react-router typegen && tsc -b",
    "rr-typegen": "react-router typegen",
    "migrations:create": "wrangler d1 migrations create",
    "migrations:apply": "wrangler d1 migrations apply",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:file-length": "node scripts/check-file-length.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "precommit": "bun run typecheck && bun run check && bun run check:file-length && bun run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@clerk/react-router": "^2.3.10",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@hono/clerk-auth": "^3.1.0",
    "@react-email/render": "^2.0.2",
    "@remixicon/react": "^4.8.0",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.11.4",
    "isbot": "^5.1.31",
    "kysely": "^0.28.9",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^0.562.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.10.0",
    "resend": "^6.7.0",
    "shadcn": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@cloudflare/vite-plugin": "^1.13.5",
    "@react-router/dev": "^7.10.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^4.0.17",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.17",
    "wrangler": "^4.59.2"
  }
}
